#%Module1.0#####################################################################
##
## rosettafold2 modulefile
##
proc ModulesHelp { } {
        global version prefix

        puts stderr "\trosettafold2- Adds rosettafold2 to your path"
}

module-whatis	"rosettafold2-1.0"

set      hpcc_modules    $::env(HPCC_MODULES)
module load miniconda3

if { [module-info mode load] || [module-info mode switch2] } {
    puts stdout "module load miniconda3; conda activate ${hpcc_modules}/rosettafold2/1.0/env;"
} elseif { [module-info mode remove] && ![module-info mode switch3] } {
    puts stdout "conda deactivate;"
}

prepend-path PATH ${hpcc_modules}/rosettafold2/1.0/RoseTTAFold2
