#%Module1.0#####################################################################
##
## allegro modulefile
##
proc ModulesHelp { } {
        global version prefix

        puts stderr "\tallegro - Adds allegro to your path"
}

module-whatis	"allegro-1.0.1"

set      hpcc_modules    $::env(HPCC_MODULES)

# Load miniconda
module load miniconda3

if { [module-info mode load] || [module-info mode switch2] } {
    puts stdout "module load miniconda3; conda activate ${hpcc_modules}/allegro/1.0.1/env;"
} elseif { [module-info mode remove] && ![module-info mode switch3] } {
    puts stdout "conda deactivate;"
}
