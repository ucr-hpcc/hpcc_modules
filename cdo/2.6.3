#%Module1.0#####################################################################
##
## cdo modulefile
##
proc ModulesHelp { } {
        global version prefix
        puts stderr "\tcdo - Adds cdo to your path"
}

module-whatis   "cdo-2.6.3"

set      hpcc_modules    $::env(HPCC_MODULES)

module load gcc/12.2.0
module load openmpi/4.1.2
module load hdf5/1.12.2
module load netcdf-c/4.9.2_openmpi-4.1.2

# Path additions
prepend-path    PATH            ${hpcc_modules}/cdo/2.6.3/bin
